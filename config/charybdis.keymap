#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 1 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    shift_caps: shift_caps {
        compatible = "zmk,behavior-tap-dance";
        label = "SHIFT_CAPS";
        #binding-cells = <0>;
        bindings = <&capital_letter LEFT_SHIFT>, <&capital_word>;
    };

    capital_letter: capital_letter {
        compatible = "zmk,behavior-sticky-key";
        label = "CAPITAL_LETTER";
        bindings = <&kp>;
        #binding-cells = <1>;
        release-after-ms = <2000>;
        quick-release;
    };

    capital_word: capital_word {
        compatible = "zmk,behavior-caps-word";
        label = "CAPITAL_WORD";
        #binding-cells = <0>;
        continue-list = <UNDERSCORE COMMA DOT LEFT_BRACKET RIGHT_BRACKET>;
        mods = <(MOD_LSFT)>;
    };

    trackball_snipe: trackball_snipe {
        compatible = "zmk,behavior-hold-tap";
        label = "TRACKBALL_SNIPE";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <180>;
        flavor = "tap-preferred";
    };

    behaviors {
    };

    macros {
        delete_jupyter: delete_jupyter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp ESCAPE>,
                <&macro_tap>,
                <&kp D>,
                <&macro_tap>,
                <&kp D>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "DELETE_JUPYTER";
        };

        add_cell_above_jupyter: add_cell_above_jupyter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp ESCAPE>,
                <&macro_tap>,
                <&kp A>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "ADD_CELL_ABOVE_JUPYTER";
        };

        add_cell_below_jupyter: add_cell_below_jupyter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp ESCAPE>,
                <&macro_tap>,
                <&kp B>,
                <&macro_tap>,
                <&kp ENTER>;

            label = "ADD_CELL_BELOW_JUPYTER";
        };

        clear_cell_jupyter: clear_cell_jupyter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp ESCAPE>,
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 200>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "CLEAR_CELL_JUPYTER";
        };

        shift_ctrl_button: shoift_ctrl_vrm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &kp LCTRL>;

            label = "SHOIFT_CTRL_VRM";
        };

        ctrl_for_vrm: ctrl_for_vrm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 200>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CTRL_FOR_VRM";
        };

        shift_for_vrm: shift_for_vrm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 200>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_SHIFT>;

            label = "SHIFT_FOR_VRM";
        };

        shift_ctrl_vrm: shift_ctrl_vrm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &kp LCTRL>,
                <&macro_wait_time 200>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_SHIFT &kp LCTRL>;

            label = "SHIFT_CTRL_VRM";
        };
    };

    combos {
        compatible = "zmk,combos";

        to_sys_right {
            bindings = <&to 6>;
            key-positions = <11 23>;
        };

        to_sys_left {
            bindings = <&to 6>;
            key-positions = <0 12>;
        };

        to_numpad {
            bindings = <&to 3>;
            key-positions = <40 37>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        home_layer {
            bindings = <
&kp TAB      &kp Q                 &kp W  &kp E          &kp R  &kp T        &kp Y               &kp U  &kp I      &kp O       &kp P          &kp LEFT_BRACKET
&shift_caps  &trackball_snipe 5 A  &kp S  &kp D          &kp F  &kp G        &kp H               &kp J  &kp K      &kp L       &kp SEMICOLON  &kp SQT
&kp LCTRL    &kp Z                 &kp X  &kp C          &kp V  &kp B        &kp N               &kp M  &kp COMMA  &kp PERIOD  &kp SLASH      &kp ESCAPE
                                          &kp BACKSPACE  &mo 4  &kp SPACE    &mt LEFT_WIN ENTER  &mo 1
            >;
        };

        symbol_eng {
            bindings = <
&kp DOLLAR  &kp MINUS  &kp LESS_THAN      &kp GREATER_THAN  &kp EXCLAMATION  &kp PERCENT      &kp AMPERSAND  &kp COLON  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp UNDERSCORE  &kp CAPS
&kp GRAVE   &kp PLUS   &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp EQUAL        &kp SEMICOLON    &kp PIPE       &kp DOT    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION    &kp DELETE
&kp LCTRL   &kp CARET  &kp SLASH          &kp STAR          &kp BACKSLASH    &kp HASH         &kp GRAVE      &kp COMMA  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AT_SIGN     &kp TILDE
                                          &kp BACKSPACE     &mo 2            &kp DELETE       &none          &none
            >;
        };

        symbol_rus {
            bindings = <
&kp ESCAPE      &kp MINUS  &none          &none     &kp EXCLAMATION  &kp PERCENT    &none  &kp CARET     &none                 &none                  &kp UNDERSCORE  &kp CAPS
&kp LEFT_SHIFT  &kp PLUS   &kp AT_SIGN    &none     &kp EQUAL        &kp DOLLAR     &none  &kp SLASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPERSAND   &kp DELETE
&kp LCTRL       &none      &kp BACKSLASH  &kp STAR  &kp PIPE         &none          &none  &kp QUESTION  &none                 &none                  &none           &none
                                          &none     &none            &none          &none  &none
            >;
        };

        numpad {
            bindings = <
&none  &none  &mt F7 NUMBER_7  &mt F8 NUMBER_8  &mt F9 NUMBER_9  &kp F10    &kp DOUBLE_QUOTES  &kp N7        &kp N8  &kp N9  &kp FSLH  &none
&none  &none  &mt F4 NUMBER_4  &mt F5 NUMBER_5  &mt F6 NUMBER_6  &kp F11    &kp MINUS          &kp N4        &kp N5  &kp N6  &kp AT    &kp HASH
&none  &none  &mt F1 NUMBER_1  &mt F2 NUMBER_2  &mt F3 NUMBER_3  &kp F12    &kp DOT            &kp NUMBER_1  &kp N2  &kp N3  &none     &none
                               &kp BACKSPACE    &to 0            &kp N0     &trans             &kp N0
            >;
        };

        navigation {
            bindings = <
&kp LA(LEFT_SHIFT)    &kp LEFT_ALT     &shift_ctrl_button  &delete_jupyter  &add_cell_above_jupyter  &ctrl_for_vrm F        &kp PG_UP      &kp HOME           &kp UP             &kp END    &kp DEL        &kp INS
&shift_for_vrm ENTER  &ctrl_for_vrm A  &kp LEFT_SHIFT      &ctrl_for_vrm C  &ctrl_for_vrm V          &clear_cell_jupyter    &kp PAGE_DOWN  &kp LEFT           &kp DOWN           &kp RIGHT  &kp BACKSPACE  &none
&kp LC(LA(DELETE))    &ctrl_for_vrm Z  &ctrl_for_vrm X     &kp LCTRL        &add_cell_below_jupyter  &ctrl_for_vrm ENTER    &none          &kp LC(BACKSPACE)  &shift_ctrl_vrm K  &none      &none          &none
                                                           &none            &none                    &none                  &kp LCTRL      &kp TAB
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans          &trans           &trans           &trans    &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &kp LEFT_SHIFT  &ctrl_for_vrm C  &ctrl_for_vrm V  &trans    &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans          &trans           &trans           &trans    &trans  &trans     &trans     &trans     &trans  &trans
                                &trans           &none            &trans    &trans  &trans
            >;
        };

        system {
            bindings = <
&bootloader  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4     &trans  &trans  &trans  &trans  &trans  &bootloader
&trans       &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4      &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans         &trans         &trans         &trans         &bt BT_CLR_ALL    &trans  &trans  &trans  &trans  &trans  &trans
                                           &trans         &to 0          &trans            &trans  &to 0
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
